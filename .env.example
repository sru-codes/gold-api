# ---------------------------------------------------------------------------
# Gold API configuration. Copy to .env for local runs; never commit real values.
# Every value below has a safe default: the service runs with an empty file.
# ---------------------------------------------------------------------------

# Master refresh loop (seconds). The snapshots are re-assembled at least this often.
REFRESH_INTERVAL_SECONDS=60

# Per-source cadences (seconds).
GOLD_INTERVAL_SECONDS=60
FX_INTERVAL_SECONDS=300
BARS_INTERVAL_SECONDS=3600
MACRO_INTERVAL_SECONDS=3600
NEWS_INTERVAL_SECONDS=900

# History windows.
BARS_HISTORY_DAYS=30
MACRO_HISTORY_DAYS=90

# Optional upstream credentials. The service works fully without them.
# goldprice.dev is keyless (rate-limited, 15-minute delayed) when left blank.
GOLDPRICE_API_KEY=
FRED_API_KEY=
GNEWS_API_KEY=

# Optional context selectors.
FRED_SERIES=DGS10
GNEWS_QUERY=gold price
GNEWS_MAX_ARTICLES=10

# Storage. On Railway, mount a volume at /data.
DATA_DIR=/data
CACHE_DIR=/data/cache

# Bearer token protecting POST /api/v1/refresh. Leave blank to allow open refresh.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# CORS: comma-separated origins, or * for any.
CORS_ORIGINS=*

# Presentation.
SERVICE_NAME=gold-api
ENGINE_VERSION=1.0.0
LOG_LEVEL=INFO
